# Local Postgres (docker compose maps 5436 — 5433 is already Aeris)
DATABASE_URL="postgresql://ccp:ccp@localhost:5436/ccpinvestment?schema=public"

# Auth.js — required. Generate with: openssl rand -base64 32
# The app refuses to start if this is empty. On Vercel also set AUTH_URL to the public origin.
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Seeded officer (used only by prisma/seed.ts — LOCAL only, never seed prod)
SEED_ADMIN_EMAIL="jack@ccpinvestment.local"
SEED_ADMIN_PASSWORD="replace-with-a-long-random-local-password"
SEED_ADMIN_NAME="Jack Doe"
