# Local Postgres (docker compose maps 5436 — 5433 is already Aeris)
DATABASE_URL="postgresql://ccp:ccp@localhost:5436/ccpinvestment?schema=public"

# Auth.js — required. Generate with: openssl rand -base64 32
# The app refuses to start if this is empty. On Vercel also set AUTH_URL to the public origin.
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Seeded officer (used only by prisma/seed.ts — LOCAL only, never seed prod)
SEED_ADMIN_EMAIL="jack@ccpinvestment.local"
SEED_ADMIN_PASSWORD="replace-with-a-long-random-local-password"
SEED_ADMIN_NAME="Jack Doe"

# One-time code that lets you create the FIRST super admin at /admin/setup (only works while no officer exists).
# Choose any long phrase; remove it after setup if you like. Everyone else is invited from the Officers page.
ADMIN_SETUP_TOKEN=""

# Optional: let the site send the branded officer-invitation email itself (https://resend.com).
# Without these, the admin gets the invite link plus a "Copy styled email" button to paste into their own mail app.
RESEND_API_KEY=""
MAIL_FROM="Chaminade Investment Club <invites@your-verified-domain.org>"
