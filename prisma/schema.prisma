generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  ACTIVE
  ALUM
  PENDING
}

enum SpeakerStatus {
  UPCOMING
  PAST
}

enum MeetingStatus {
  CONFIRMED
  TENTATIVE
  OPEN
}

enum ApplicationType {
  STUDENT
  SPEAKER
}

enum ApplicationStatus {
  NEW
  REVIEWING
  APPROVED
  REJECTED
  ARCHIVED
}

enum OfficerRole {
  /// Shown as "Co-President" (a club can have more than one).
  PRESIDENT
  VP
  SECRETARY
  TREASURER
  ADVISOR
  PORTFOLIO_MANAGER
}

enum PageStatus {
  LIVE
  DRAFT
}

model Officer {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           OfficerRole
  classYear      String?
  bio            String?
  /// Optional photo (a path such as /api/photo/<id>); shown on the public Team page.
  photoUrl       String?
  permissions    String[]     @default([])
  /// Super admins can invite, edit, deactivate and delete other officers.
  isSuperAdmin   Boolean      @default(false)
  /// Deactivated officers cannot sign in; their notes and history stay.
  active         Boolean      @default(true)
  /// Set on accounts created with a temporary password; forces a change at first sign-in.
  mustChangePassword Boolean  @default(false)
  lastLoginAt    DateTime?
  failedLogins   Int          @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notes          Note[]
  reviewedApps   Application[] @relation("ReviewedBy")
  pageUpdates    PageContent[]
  invitesSent    Invitation[]
}

model Member {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  email     String       @unique
  gradYear  String
  /// Optional photo (a path under /public). Only members with a photo are listed on the public Team page.
  photoUrl  String?
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime     @default(now())
  role      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
}

model Speaker {
  id          String        @id @default(cuid())
  firstName   String
  lastName    String
  firm        String
  title       String
  bio         String        @default("")
  topic       String        @default("")
  photoUrl    String?
  linkedinUrl String?
  industry    String?
  status      SpeakerStatus @default(UPCOMING)
  sessionDate DateTime?
  season      String?
  /// Optional career story: { timeline: [{ when, title, org, detail }], pillars: [{ title, text }] }
  highlights  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  meetings    Meeting[]

  @@index([status])
}

model Meeting {
  id        String        @id @default(cuid())
  date      DateTime
  time      String
  location  String
  topic     String        @default("")
  format    String        @default("Talk + Q&A")
  duration  String        @default("~45 min")
  status    MeetingStatus @default(TENTATIVE)
  published Boolean       @default(false)
  rsvpCount Int           @default(0)
  photoUrl  String?
  speakerId String?
  speaker   Speaker?      @relation(fields: [speakerId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([date])
  @@index([published])
}

model Application {
  id          String            @id @default(cuid())
  type        ApplicationType
  payload     Json
  status      ApplicationStatus @default(NEW)
  flagged     Boolean           @default(false)
  submittedAt DateTime          @default(now())
  reviewedById String?
  reviewedBy  Officer?          @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  promotedId  String?
  notes       Note[]

  @@index([type, status])
  @@index([submittedAt])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String?
  author        Officer?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Snapshot of the author's name, so a note keeps its byline if the officer is removed.
  authorName    String      @default("")
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  targetType String
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PageContent {
  slug      String     @id
  title     String
  path      String
  blocks    Json
  status    PageStatus @default(DRAFT)
  updatedAt DateTime   @updatedAt
  updatedById String?
  updatedBy Officer?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model ClubSettings {
  id               String  @id @default("club")
  name             String  @default("Chaminade Investment Club")
  shortName        String  @default("CIC")
  foundedYear      String  @default("2024")
  meetingLocation  String  @default("Little Theatre")
  meetingTime      String  @default("7:45 AM")
  seasonLabel      String  @default("Spring 2026")
  /// Headline numbers on the home page, shown as written (e.g. "60+").
  statMembers      String  @default("60+")
  statSpeakers     String  @default("12+")
  statSessions     String  @default("24+")
  /// Small caption on the home hero photo. Empty hides it.
  heroCaption      String  @default("")
  contactEmail     String?
  instagramUrl     String?
  /// Class years offered on the join form, first to last (inclusive).
  classYearFrom    Int     @default(2027)
  classYearTo      Int     @default(2035)
}

/// A replaced website photo (home hero, page banners...) and how it is cropped. No row = the original image.
model SiteImage {
  slot      String   @id
  photoUrl  String
  /// Crop focus, 0-100 (CSS object-position percentages).
  focusX    Int      @default(50)
  focusY    Int      @default(50)
  alt       String   @default("")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Uploaded images (speaker, member and officer photos, meeting photos). Stored in the database so
/// uploads work on every host, including read-only ones. Served from /api/photo/<id>.
model Photo {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  size      Int
  label     String   @default("")
  createdAt DateTime @default(now())
}

/// An invitation for someone to create an officer account. Only a hash of the token is stored.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String    @default("")
  role        OfficerRole
  classYear   String?
  tokenHash   String    @unique
  invitedById String?
  invitedBy   Officer?  @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

/// Someone asking for officer access from the public sign-up page. A super admin approves or denies.
model AccessRequest {
  id          String              @id @default(cuid())
  name        String
  email       String
  classYear   String?
  roleWanted  String              @default("")
  message     String              @default("")
  status      AccessRequestStatus @default(PENDING)
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@index([status])
  @@index([email])
}
